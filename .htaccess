# Destinify: Apache settings. GitHub Pages and other static hosts ignore this file
# (they still get the CSP <meta> tag in index.html).
Options -Indexes

# Never serve repository, editor, database, tooling or doc files
RedirectMatch 404 "(?i)(^|/)\.(git|vscode)(/|$)"
RedirectMatch 404 "(?i)(^|/)(database|tools|docs)(/|$)"
<FilesMatch "(?i)(\.(sql|py|log|bak|patch|sh|ini|ya?ml)|^\.git.*|^composer\.(json|lock))$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), payment=(), usb=(), microphone=(self), geolocation=(self)"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/ https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/ https://cdnjs.cloudflare.com/ajax/libs/leaflet.markercluster/1.5.3/; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/ https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/ https://cdnjs.cloudflare.com/ajax/libs/leaflet.markercluster/1.5.3/; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://api.open-meteo.com https://en.wikipedia.org https://commons.wikimedia.org https://upload.wikimedia.org https://fonts.googleapis.com https://fonts.gstatic.com https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/ https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/ https://cdnjs.cloudflare.com/ajax/libs/leaflet.markercluster/1.5.3/; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    # The service worker script gets its own CSP: it fetches CDN files, fonts and images for the offline cache
    <Files "sw.js">
        Header always set Content-Security-Policy "default-src 'self'; connect-src 'self' https:; script-src 'self'; object-src 'none'; base-uri 'none'"
    </Files>
    # Only sent over HTTPS (browsers ignore it on http)
    Header always set Strict-Transport-Security "max-age=15552000" "expr=%{HTTPS} == 'on'"
</IfModule>
